WITH ranked_purchases AS (
  SELECT
    COALESCE(user_id, user_pseudo_id) AS customer_id,
    ecommerce.transaction_id AS order_id,
    ecommerce.purchase_revenue AS revenue,
    DATE(TIMESTAMP_MICROS(event_timestamp)) AS order_date,
    TIMESTAMP_MICROS(event_timestamp) AS order_timestamp,
    traffic_source.source AS source,
    traffic_source.medium AS medium,
    traffic_source.name AS campaign,
    
    -- Rank purchases chronologically per customer
    DENSE_RANK() OVER (
      PARTITION BY COALESCE(user_id, user_pseudo_id) 
      ORDER BY event_timestamp ASC
    ) AS purchase_rank
  FROM
    `enter.tablename_123456.events_*`
  WHERE
    _TABLE_SUFFIX >= FORMAT_DATE('%Y%m%d', DATE_SUB(CURRENT_DATE(), INTERVAL 24 MONTH))
    AND event_name = 'purchase'
    AND ecommerce.transaction_id IS NOT NULL
)

SELECT
  customer_id,
  order_id,
  revenue,
  order_date,
  source,
  medium,
  campaign,
  CASE
    WHEN purchase_rank = 1 THEN 'new customer'
    ELSE 'returning customer'
  END AS customer_type
FROM
  ranked_purchases
ORDER BY
  order_date DESC,
  order_timestamp DESC;
